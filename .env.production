# Variables públicas para builds de producción (next build / opennextjs-cloudflare build).
# No aplican a `next dev` — ahí manda .env.local. No contiene secretos.
# Sin esto, assetUrl() cae a rutas relativas y Unity pide /Unity/Build/* al propio
# dominio → 404/HTML → error de "identificación" de archivos en el loader.
NEXT_PUBLIC_ASSETS_URL=https://assets.athernix.com
