# ─────────────────────────────────────────────────────────────
# Variables públicas (NEXT_PUBLIC_*) — se inlinean en el bundle
# durante `next build`, por lo que deben existir EN TIEMPO DE BUILD.
# En Cloudflare Workers se definen como "Build variables" del proyecto.
# ─────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# URL pública del sitio (callbacks de OAuth / OTP de Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# R2 Assets URL — Cloudflare Worker que sirve los assets >25 MiB desde R2
# (builds de Unity y modelos 3D pesados; ver public/.assetsignore).
# Dejar vacío en local para servir desde /public.
# Dev:  https://r2-assets.athernixito.workers.dev
# Prod: https://assets.athernix.com
NEXT_PUBLIC_ASSETS_URL=https://assets.athernix.com

# ─────────────────────────────────────────────────────────────
# Secretos de servidor — NO usar NEXT_PUBLIC_.
# En local van en .env.local (next dev) y .dev.vars (wrangler preview).
# En producción se cargan con:
#   npx wrangler secret put <NOMBRE>
# ─────────────────────────────────────────────────────────────

GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
EXA_API_KEY=your_exa_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Google OAuth (configured in Supabase, not needed here)
# Configure Google OAuth in Supabase Dashboard:
# 1. Go to Authentication > Providers > Google
# 2. Enable Google provider
# 3. Add your Google Client ID and Client Secret from Google Cloud Console
# 4. Configure authorized redirect URLs

# GitHub OAuth (configured in Supabase, not needed here)
# Configure GitHub OAuth in Supabase Dashboard:
# 1. Go to Authentication > Providers > GitHub
# 2. Enable GitHub provider
# 3. Add your GitHub Client ID and Client Secret from GitHub Developer Settings
# 4. Configure authorized redirect URLs
